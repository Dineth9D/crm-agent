# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here
SUPABASE_SECRET_KEY=your_service_role_key_here

# Admin access: required in the X-Admin-Key header for POST /seed.
# Leave empty to disable seeding. Use a long random value.
ADMIN_API_KEY=

# Embeddings always use OpenAI, so this is required for both providers.
OPENAI_API_KEY=

# Chat provider: openai or anthropic
AI_PROVIDER=openai
# OPENAI_CHAT_MODEL=gpt-4o
# OPENAI_UTILITY_MODEL=            # query rewriting + grading; empty = chat model
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5
# ANTHROPIC_UTILITY_MODEL=claude-haiku-5-5

# Chunks below this cosine similarity are dropped (0.0 turns it off).
MIN_SIMILARITY=0.5

# Conversation memory: memory (lost on restart) or postgres
CHECKPOINTER=memory
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
